// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id                 String                 @id @default(cuid())
  name               String
  description        String?
  color              String                 @default("#3b82f6")
  apiKey             String?                @unique
  apiKeyHash         String?                @unique
  apiKeyPreview      String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tasks              Task[]
  agents             Agent[]
  activities         ActivityLog[]
  modes              ProjectMode[]
  runtimes           ProjectRuntime[]
  mcpConnections     ProjectMcpConnection[]
  chainTemplates     ChainTemplate[]
  taskTemplates      TaskTemplate[]
  recurringTasks     RecurringTask[]
  memories           AgentMemory[]
  triggers           Trigger[]
  scopedKeys         ApiKey[] // B-4: scoped integration keys bound to this project
  // Automation scheduler config
  automationMode     String                 @default("manual") // manual, always, scheduled, startup
  automationSchedule String? // JSON: { startDay, startTime, endDay, endTime }
  automationPollMs   Int                    @default(10000) // poll interval in ms
  // Activity log retention (null = keep forever)
  logRetentionDays   Int?
  // Project defaults (Epic S1): consumed at task creation
  defaultStepMode        String? // mode for the auto-created step on agent-assigned stepless tasks
  defaultChainTemplateId String? // prefills the task dialog's step builder
  // Time-based automation (Epic S7 Phase 2): null = sweep disabled
  autoArchiveDays        Int? // DONE tasks idle this long emit task-stale events
  reviewEscalationHours  Int? // active human gates older than this emit review-gate-stale
  lastAutomationSweepAt  DateTime? // sweep claim timestamp (max once/hour)
  // Artifact retention for DONE tasks (null = keep forever)
  artifactRetentionDays  Int?
  // B-7 spend budget: month-to-date recorded cost >= budgetUsd pauses dispatch.
  // Nullable column IS the feature flag (null = no budget = unchanged behaviour).
  budgetUsd              Float?
  // Workspace container (nullable; backfilled)
  workspaceId        String?
  workspace          Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model Agent {
  id               String              @id @default(cuid())
  name             String
  emoji            String              @default("🤖")
  color            String              @default("#3b82f6")
  description      String?
  personality      String?
  apiKey           String?             @unique
  apiKeyHash       String?             @unique
  apiKeyPreview    String?
  isActive         Boolean             @default(false)
  lastSeen         DateTime?
  projectId        String
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            Task[]
  activities       ActivityLog[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  role             String?
  category         String? // grouping for the agents UI (e.g. "Domain-Driven Design")
  capabilities     String?
  maxConcurrent    Int                 @default(1)
  supportedModes   String?
  modeInstructions String?
  runtimeId        String?
  runtime          ProjectRuntime?     @relation(fields: [runtimeId], references: [id], onDelete: SetNull)
  runtimeModel     String?
  systemPrompt     String?
  mcpConnectionIds String?
  taskSteps        TaskStep[]          @relation("TaskStepAgent")
  memories         AgentMemory[]
  // HTTP = legacy polling agent; DAEMON = launched by conductor-daemon
  invocationMode   AgentInvocationMode @default(HTTP)
}

// NOTE: deletedAt (Epic S3) — soft delete with a 30-day grace period; all
// live read/dispatch paths filter deletedAt: null, hard purge is lazy.
model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(BACKLOG)
  priority    TaskPriority  @default(MEDIUM)
  tag         String?
  notes       String?
  output      String? // Agent output/result
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  startedAt   DateTime? // When agent started working
  completedAt DateTime? // When task was completed
  deletedAt   DateTime? // Soft delete (Epic S3); hard-purged after 30 days
  archivedAt  DateTime? // Archive (Epic S7): kept forever, hidden from the board
  // Claim Lease (B-2, Model B): liveness bound on an external agent's task
  // claim. Set on claim/start, renewed by agent heartbeats, cleared on
  // completion. Dispatcher-driven tasks NEVER set this — the reaper uses it
  // to distinguish reapable Model-B claims from chain-dispatch IN_PROGRESS.
  claimExpiresAt DateTime?
  // Due date (D-2): optional deadline. Stored as an instant (the picker writes
  // end-of-day so a date-only due date isn't "overdue" at 00:00 on the day).
  // Null = no due date. Drives the card badge, the D-1 overdue filter, and the
  // scheduler's overdue-reminder sweep.
  dueDate          DateTime?
  // Overdue-reminder dedupe (D-2-T2): stamped the first time the sweep emits a
  // task_overdue notification for this task. A guarded compare-and-set on this
  // column (NULL → now) makes the emit exactly-once and race-tolerant, mirroring
  // the claim-reaper's guarded write.
  dueReminderSentAt DateTime?
  order            Int           @default(0)
  runtimeOverride  String?       // Per-task runtime override (claude-code | codex | copilot)
  activities       ActivityLog[]
  steps            TaskStep[]

  @@index([projectId, status])
  @@index([projectId, deletedAt])
  @@index([projectId, archivedAt])
  // Reaper sweep: IN_PROGRESS tasks with an expired claim lease
  @@index([status, claimExpiresAt])
  // Overdue sweep: the hot predicate is a dueDate range scan (`dueDate not null
  // and < now`). Indexing dueDate lets SQLite skip the majority of tasks (those
  // with no due date) without a full scan; the status (notIn DONE) and
  // dueReminderSentAt null-guard are cheap post-filters.
  @@index([dueDate])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  level     String   @default("info") // debug | info | warn | error
  component String?                   // task | agent | daemon | wizard | runtime | system
  traceId   String?
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  userId    String? // acting user (Phase 2 attribution); null for agent/system writes
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  details   String?
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, level])
  @@index([projectId, component])
  @@index([traceId])
}

model ProjectMode {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  label        String
  color        String   @default("#60A5FA")
  icon         String?
  instructions String?
  // Mode policy (Epic S4)
  maxAttempts   Int? // default maxRetries for steps created in this mode
  toolAllowlist String? // JSON string[]: namespaced tool patterns ("conn__tool", "conn__*"); null = no restriction
  outputFormat  String? // markdown | json | diff | plain — appended as a prompt hint
  createdAt    DateTime @default(now())

  @@unique([projectId, name])
}

model ProjectRuntime {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adapter      String
  name         String
  models       String
  apiKeyEnvVar String?
  endpoint     String?
  config       String?
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  agents       Agent[]

  @@unique([projectId, adapter, name])
}

model ProjectMcpConnection {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      String
  icon      String?
  endpoint  String?
  config    String?
  scopes    String?
  toolUsage McpToolUsage[]
  createdAt DateTime       @default(now())
}

// Per-tool usage counters (Epic S5 leftover): incremented fire-and-forget on
// every tool invocation, surfaced in the MCP tools expander.
model McpToolUsage {
  id           String               @id @default(cuid())
  connectionId String
  connection   ProjectMcpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  toolName     String
  count        Int                  @default(0)
  lastUsedAt   DateTime             @default(now())

  @@unique([connectionId, toolName])
}

model ChainTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String   @default("🔗")
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps         String
  taskTemplates TaskTemplate[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Task templates (Epic S6): saved task-form defaults surfaced in the board's
// create flow. The optional chain link degrades to null if the chain template
// is deleted — the task template keeps its field defaults.
model TaskTemplate {
  id              String          @id @default(cuid())
  name            String
  icon            String          @default("📋")
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  titlePattern    String? // supports {date} -> YYYY-MM-DD at pick time
  description     String?
  priority        String? // LOW | MEDIUM | HIGH | URGENT
  tag             String?
  notes           String?
  chainTemplateId String?
  chainTemplate   ChainTemplate?  @relation(fields: [chainTemplateId], references: [id], onDelete: SetNull)
  recurrences     RecurringTask[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Recurring tasks: instantiate a task template on a cadence. Runs from the
// scheduler's global tick; nextRunAt doubles as the atomic claim column.
model RecurringTask {
  id             String       @id @default(cuid())
  name           String
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskTemplateId String
  taskTemplate   TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  cadence        String // daily | weekly | monthly
  dayOfWeek      Int? // 0=Sunday..6, weekly only
  dayOfMonth     Int? // 1-28, monthly only
  timeOfDay      String // "HH:MM" server-local
  enabled        Boolean      @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([enabled, nextRunAt])
}

model TaskStep {
  id               String          @id @default(cuid())
  taskId           String
  task             Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  order            Int
  agentId          String?
  agent            Agent?          @relation("TaskStepAgent", fields: [agentId], references: [id], onDelete: SetNull)
  humanLabel       String?
  mode             String
  instructions     String?
  autoContinue     Boolean         @default(true)
  status           String          @default("pending")
  output           String?
  error            String?
  startedAt        DateTime?
  completedAt      DateTime?
  rejectionNote    String?
  attempts         Int             @default(0)
  maxRetries       Int             @default(2)
  retryDelayMs     Int             @default(5000)
  timeoutMs        Int             @default(300000)
  leasedAt         DateTime?
  leasedBy         String?
  requiredSignOffs Int             @default(1)
  // DAG fields (coexist with linear 'order' for backward compatibility)
  nextSteps        String? // JSON: Array<{ targetStepId: string; condition?: { field, operator, value }; label?: string }>
  prevSteps        String? // JSON: Array<string> — for merge/join detection
  isParallelRoot   Boolean         @default(false)
  isMergePoint     Boolean         @default(false)
  fallbackAgentId  String?
  traceContext     String? // JSON: W3C trace propagation carrier captured at creation
  createdAt        DateTime        @default(now())
  executions       StepExecution[]
  reviews          StepReview[]
  artifacts        StepArtifact[]
  stepEvents       StepEvent[]

  @@unique([taskId, order])
  @@index([taskId, status])
  @@index([agentId, status])
}

// Append-only event log per step: leased | started | succeeded | failed |
// retry_scheduled | dead_lettered. Never updated or deleted while the step
// lives — the audit trail for debugging dispatch behaviour.
model StepEvent {
  id        String   @id @default(cuid())
  stepId    String
  step      TaskStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  event     String
  data      String? // JSON — error message, worker id, delayMs, retryAt, etc.
  createdAt DateTime @default(now())

  @@index([stepId])
  @@index([stepId, event])
}

// Snapshot of a step whose retries (and fallback agent, if any) are exhausted.
// Rows survive even if the original step or task is deleted — that is the point
// of a dead-letter table, so no relation/cascade on purpose.
model DeadLetterStep {
  id             String    @id @default(cuid())
  originalStepId String
  taskId         String
  agentId        String?
  mode           String
  instructions   String?
  attempts       Int
  lastError      String?
  lastErrorAt    DateTime?
  payload        String? // JSON snapshot of the step at time of failure
  movedAt        DateTime  @default(now())

  @@index([taskId])
}

model StepExecution {
  id          String    @id @default(cuid())
  stepId      String
  step        TaskStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  attempt     Int
  status      String    @default("running")
  output      String?
  error       String?
  evidence    String? // JSON: retrieval context captured at dispatch (memoryHits, workingMemory)
  tokensUsed  Int?
  cost        Float?
  durationMs  Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  toolCalls ToolCallTrace[]

  @@unique([stepId, attempt])
  @@index([stepId])
}

model ToolCallTrace {
  id          String        @id @default(cuid())
  executionId String
  execution   StepExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  toolName    String
  args        String? // JSON
  result      String? // truncated
  durationMs  Int?
  error       String?
  createdAt   DateTime      @default(now())
}

model StepArtifact {
  id          String   @id @default(cuid())
  stepId      String
  step        TaskStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  executionId String?
  type        String // text, code, diff, url, image, file, json, log, test_result
  label       String // human-readable name
  content     String? // inline content (text, code, JSON, diff)
  url         String? // external URL (image, file download, screenshot)
  mimeType    String? // e.g., "application/json", "image/png"
  metadata    String? // JSON — extra info
  createdAt   DateTime @default(now())
}

model StepReview {
  id           String    @id @default(cuid())
  stepId       String
  step         TaskStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  reviewer     String
  decision     String // approved, rejected, revision_requested
  note         String?
  // Set when a later rejection/revision resets the step — these reviews
  // no longer count toward the next approval gate but remain for audit.
  supersededAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([stepId, supersededAt])
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  WAITING
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Daemon + workspaces ──────────────────────────────────────────────────

model Workspace {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
  daemons   Daemon[]
  skills    Skill[]
  hosts     Host[]
}

// A durable machine identity. A daemon is a process running on a host;
// hosts survive daemon restarts and re-registrations (slug = daemon-persisted
// installation ID, or normalized hostname for legacy daemons).
model Host {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug        String
  displayName String
  hostname    String
  platform    String
  arch        String?
  labels      String?   // JSON string[]
  trustLevel  String    @default("local") // local | lan | remote | cloud
  status      String    @default("offline") // online | stale | offline (derived; denormalized for list queries)
  lastSeenAt  DateTime?
  metadata    String?   // JSON: cpu/memory/os release + latest heartbeat metrics
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  daemons     Daemon[]
  sessions    AgentSession[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

// An observable local execution session reported by a daemon (pty, tmux,
// process). Owned by the daemon — identity always derives from the daemon
// token, never the payload. daemonId is intentionally NOT a relation so
// sessions survive daemon re-registration. Stores only a redacted output
// tail; durable results live in executions/artifacts.
model AgentSession {
  id             String    @id @default(cuid())
  workspaceId    String
  projectId      String?
  agentId        String?
  daemonId       String
  hostId         String?
  taskId         String?
  stepId         String?
  sessionKey     String    // daemon-local stable name
  backend        String    // pty | tmux | process | container
  cwd            String?
  command        String?   // summary only, never raw input streams
  status         String    @default("starting") // starting | active | idle | waiting | exited | failed
  lastActivityAt DateTime?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  exitCode       Int?
  outputPreview  String?   // redacted, bounded tail (~5KB)
  metadata       String?   // JSON

  host Host? @relation(fields: [hostId], references: [id], onDelete: SetNull)

  @@unique([daemonId, sessionKey])
  @@index([workspaceId, status])
  @@index([projectId, agentId])
  @@index([taskId, stepId])
}

// Instance-wide admin settings (Epic S2). Singleton row; the DB password
// hash (scrypt) overrides the AGENTBOARD_ADMIN_PASSWORD env var, which
// remains the bootstrap / break-glass credential.
model AdminConfig {
  id              String   @id @default("singleton")
  passwordHash    String? // scrypt: "salt:hash" hex
  sessionTtlHours Int      @default(12)
  updatedAt       DateTime @updatedAt
}

// Per-user accounts (Phase 1): named users replace the shared admin password.
// The owner bootstraps from the legacy credential on first login.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String // scrypt "salt:hash" hex (admin-config helpers)
  role         String        @default("member") // owner | admin | member
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  sessions     UserSession[]
  resetTokens  PasswordResetToken[]
  activities   ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Self-service password reset + email invites (D-5). Only the SHA-256 hash of
// the raw token is stored (like UserSession) so a DB leak never yields a live
// reset link. Single-use: usedAt is stamped on consume; expired/used/unknown
// tokens are all rejected. Cascade on user delete.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 of the raw `cr_…` token
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// DB-backed sessions: only the token hash is stored, enabling per-user
// revocation ("deactivate now", "sign out everywhere").
model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 of the cookie value
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Agent messaging ───────────────────────────────────────────────────────

// A stable, human-readable address for an agent within a project
// (auto-provisioned as a name slug on first use). Project-scoped: agents
// can only message peers in their own project.
model AgentAddress {
  id        String   @id @default(cuid())
  agentId   String
  projectId String
  address   String
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([projectId, address])
  @@index([agentId])
}

// Durable, task-aware agent-to-agent (or admin-to-agent) message. The body
// is stored as written; content-safety verdicts live in bodySecurity and
// flagged bodies are wrapped at DELIVERY, keeping the original intact for
// admin forensics. Messages never advance chains in v1.
model AgentMessage {
  id           String    @id @default(cuid())
  projectId    String
  workspaceId  String?
  taskId       String?
  stepId       String?
  threadId     String?
  fromAgentId  String?
  toAgentId    String?
  fromAddress  String
  toAddress    String
  priority     String    @default("normal") // low | normal | high | urgent
  subject      String?
  body         String
  bodySecurity String?   // JSON: { trust, flags } from content-safety
  status       String    @default("queued") // queued | delivered | read | archived
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?

  @@index([projectId, toAgentId, status])
  @@index([taskId])
  @@index([threadId])
}

enum AgentInvocationMode {
  HTTP
  DAEMON
}

// Populated by conductor-daemon registrations.
model Daemon {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostname     String
  platform     String // "darwin" | "linux" | "win32"
  version      String
  capabilities String // JSON: { "claude-code": {version, path}, ... }
  tokenHash    String    @unique
  tokenPreview String
  lastSeenAt   DateTime?
  status       String    @default("offline") // offline | online | stale
  createdAt    DateTime  @default(now())

  hostId              String?
  host                Host?   @relation(fields: [hostId], references: [id], onDelete: SetNull)
  sessionCapabilities String? // JSON — reserved for Epic 2 (session backends); written by register when provided

  @@index([workspaceId, status])
  @@index([hostId])
}

// ─── Skills library ───────────────────────────────────────────────────────

model Skill {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  body         String    // markdown content — the actual skill/playbook
  tags         String?   // JSON array of tags
  embedding    String?   // JSON float array on SQLite; cast to vector(1536) via raw SQL on Postgres
  sourceTaskId String?
  version      Int       @default(1)
  parentId     String?   // points to previous version's id
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId])
}

model AgentMemory {
  id            String    @id @default(cuid())
  agentId       String
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      String    // fact | decision | preference | pattern
  content       String
  sourceTaskId  String?   // task that produced this memory, if any
  confidence    Float     @default(0.8)
  reinforcement Int       @default(1)
  lastAccessed  DateTime?
  embedding     String?   // JSON float array on SQLite; cast to vector(1536) via raw SQL on Postgres
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([agentId, projectId])
  @@index([projectId])
}

model Trigger {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String     // "event" | "poll:sentry"
  eventType   String?    // for type="event": "chain-completed" | "step-failed" | "task-created" | "step-reviewed"
  eventFilters String    @default("[]")
  pollConfig  String     @default("{}")
  enabled     Boolean    @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reactions   Reaction[]

  @@index([projectId])
  @@index([projectId, type])
  @@index([projectId, eventType])
}

model Reaction {
  id                  String    @id @default(cuid())
  triggerId           String
  trigger             Trigger   @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  name                String
  type                String    // "post:slack" | "post:http" | "create:jira" | "send:email"
  config              String    @default("{}")
  order               Int       @default(0)
  enabled             Boolean   @default(true)
  dryRun              Boolean   @default(false) // log what would happen, mutate nothing
  consecutiveFailures Int       @default(0)
  lastError           String?
  lastFiredAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([triggerId, order])
}

// C-4 notification center: an event that needs a human (review gate waiting
// for sign-off, dead-lettered step, budget exceeded). Deliberately
// relation-free (like DeadLetterStep) so rows survive project/task deletion;
// projectId is nullable to allow future instance-wide notices.
model Notification {
  id        String    @id @default(cuid())
  projectId String?
  type      String // review_gate_waiting | dead_letter | budget_exceeded | task_overdue
  title     String
  body      String?
  taskId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
  @@index([projectId])
}

// Scoped API keys for external integrations (CI, scripts, webhooks).
// The raw key is shown once at issue time; only prefix + SHA-256 hash are stored.
model ApiKey {
  id         String    @id @default(cuid())
  prefix     String    @unique // first 8 chars of the raw key, plaintext — for O(1) lookup
  keyHash    String    @unique // SHA-256 of the full raw key — never store the raw key
  label      String
  scopes     String    @default("[]") // JSON: ["read", "write", "mcp:execute"]
  // Project binding (B-4): null = legacy unbound key (instance-wide, deprecated).
  // Cascade on project delete — a bound key must never silently widen back to
  // instance-wide when its project disappears.
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([projectId])
}
