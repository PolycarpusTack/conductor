# Dependencies (reinstalled inside the image)
node_modules
**/node_modules

# Build output (rebuilt inside the image)
.next
out
build
dist
*.tsbuildinfo

# Generated Prisma client (regenerated by `prisma generate` during build)
src/generated

# Local databases — never bake a dev DB into an image
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Secrets & local env
.env
.env.*
!.env.example

# Logs
*.log

# VCS & tooling
.git
.gitignore
.github
.vscode
.idea

# Docker artifacts themselves
Dockerfile
**/Dockerfile
.dockerignore
docker-compose.yml

# Docs & misc that the image does not need
coverage
*.md
docs
