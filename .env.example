# --- Database ---------------------------------------------------------------
# SQLite (default — also used when DATABASE_URL is unset):
DATABASE_URL=file:./prisma/dev.db
# PostgreSQL + pgvector (enables semantic memory/skill search):
# DATABASE_URL=postgresql://agentboard:agentboard@localhost:5432/agentboard

# --- Admin auth ---------------------------------------------------------------
# Password for the dashboard login. Required in production; min 8 characters.
AGENTBOARD_ADMIN_PASSWORD=change-me-please
# Optional separate secret for signing session cookies (min 16 chars).
# Falls back to the admin password when unset.
# AGENTBOARD_ADMIN_SESSION_SECRET=change-me-at-least-16-chars

# --- WebSocket realtime (optional — needed for live updates) ------------------
# Shared secrets with the board-ws mini-service (min 16 chars each).
# AGENTBOARD_WS_SECRET=change-me-at-least-16-chars
# AGENTBOARD_WS_INTERNAL_SECRET=change-me-at-least-16-chars

# --- Prompt archive & agent wizard (optional) ---------------------------------
# Local directory of markdown prompt templates for the archive browser.
# PROMPT_LIBRARY_PATH=/path/to/your/prompt/archive
# Needed for the agent wizard LLM composition and memory embeddings.
# OPENAI_API_KEY=sk-...
